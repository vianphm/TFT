{
  "name": "blitz-tft-companion",
  "productName": "Blitz TFT Companion",
  "version": "1.0.0",
  "description": "Blitz Clone - Trợ thủ Đấu Trường Chân Lý & In-Game Transparent Overlay",
  "main": "src/main/index.js",
  "author": "vianphm",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node test/app.test.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.vianphm.blitztft",
    "productName": "Blitz TFT Companion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}