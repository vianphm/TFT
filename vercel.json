{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'PC web app'",
  "outputDirectory": "src/renderer/dashboard",
  "framework": null,
  "functions": {
    "api/tft-data.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
